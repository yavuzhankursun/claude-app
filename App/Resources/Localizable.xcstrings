    "Claude Code CLI bulunamadı. Kurup terminalde bir kez `claude` ile giriş yapın; ya da Ayarlar'dan yolu belirtin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code CLI not found. Install it and sign in once with `claude` in Terminal, or set its path in Settings."
          }
        }
      }
    },
